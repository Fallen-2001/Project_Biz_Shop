<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- Główny unit dla domyślnej bazy H2 w Payara -->
    <persistence-unit name="shopPU" transaction-type="JTA">
        <jta-data-source>jdbc/__default</jta-data-source>

        <class>org.example.model.User</class>
        <class>org.example.model.Product</class>
        <class>org.example.model.CartItem</class>
        <class>org.example.model.Order</class>
        <class>org.example.model.OrderItem</class>

        <properties>
            <!-- Strategia generowania bazy danych -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="jakarta.persistence.schema-generation.create-source" value="metadata"/>
            <property name="jakarta.persistence.schema-generation.drop-source" value="metadata"/>

            <!-- EclipseLink properties dla H2 -->
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
            <property name="eclipselink.ddl-generation" value="drop-and-create-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>

            <!-- Logging -->
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>

            <!-- Sequencing dla H2 -->
            <property name="eclipselink.sequencing.default-sequence-to-table" value="true"/>
            <property name="eclipselink.sequencing.sequence-name-field" value="SEQ_NAME"/>
            <property name="eclipselink.sequencing.sequence-counter-field" value="SEQ_COUNT"/>
            <property name="eclipselink.sequencing.sequence-table" value="SEQUENCE"/>

            <!-- Performance settings -->
            <property name="eclipselink.cache.shared.default" value="false"/>
            <property name="eclipselink.flush-clear.cache" value="DropInvalidate"/>
        </properties>
    </persistence-unit>

</persistence>